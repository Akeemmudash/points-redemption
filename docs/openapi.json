                            "type": "string",
                            "format": "date"
                        },
                        "example": "2026-06-30"
                    },
                    {
                        "name": "customer_id",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 11
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "pending",
                                "successful",
                                "failed"
                            ]
                        }
                    },
                    {
                        "name": "service_type",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "airtime",
                                "data",
                                "electricity",
                                "cable_tv"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Summary report retrieved",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "properties": {
                                                "total_redemptions": {
                                                    "type": "integer",
                                                    "example": 15
                                                },
                                                "total_points_deducted": {
                                                    "type": "integer",
                                                    "example": 4500
                                                },
                                                "total_amount": {
                                                    "type": "integer",
                                                    "example": 450000
                                                },
                                                "success_rate": {
                                                    "type": "number",
                                                    "format": "float",
                                                    "example": 86.67
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/reports/export": {
            "get": {
                "tags": [
                    "Reports"
                ],
