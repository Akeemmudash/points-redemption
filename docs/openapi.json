                    "404": {
                        "description": "Not found"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Customers"
                ],
                "summary": "Update a customer",
                "operationId": "32da1527afa82d1a6b0e034146f1032d",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 11
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Ada Lovelace"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "ada@example.com"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "+2348012345678"
                                    },
                                    "points_balance": {
                                        "type": "integer",
                                        "example": 1000
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Customer updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Customer"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not found"
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/customers/{id}/deactivate": {
            "patch": {
                "tags": [
                    "Customers"
                ],
                "summary": "Deactivate a customer",
                "operationId": "b7f558ba6713b7df3cb739faf2db1824",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 11
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Customer deactivated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Customer"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not found"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/reconciliation/run": {
            "post": {
                "tags": [
                    "Reconciliation"
                ],
                "summary": "Run reconciliation",
                "operationId": "55b72215f644131b8fe8cc3c5ca37226",
                "responses": {
                    "200": {
                        "description": "Reconciliation run triggered",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Queued 1 pending redemption(s) for reconciliation."
                                        },
                                        "queued": {
                                            "type": "integer",
                                            "example": 1
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/redemptions": {
            "get": {
                "tags": [
                    "Redemptions"
                ],
                "summary": "List redemptions",
                "operationId": "4981e12ad8e56f17b8e44a62c587504d",
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "pending",
                                "successful",
                                "failed"
                            ]
                        }
                    },
                    {
                        "name": "service_type",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "airtime",
                                "data",
                                "electricity",
                                "cable_tv"
                            ]
                        }
                    },
                    {
                        "name": "customer_id",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "from",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date"
                        },
                        "example": "2026-06-01"
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date"
                        },
                        "example": "2026-06-30"
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of redemptions"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Redemptions"
                ],
                "summary": "Create a redemption",
                "operationId": "278b1e590c5f6f7547c23715712d665b",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "customer_id",
                                    "points",
                                    "amount",
                                    "service_type",
                                    "idempotency_key"
                                ],
                                "properties": {
                                    "customer_id": {
                                        "type": "integer",
                                        "example": 11
                                    },
                                    "points": {
                                        "type": "integer",
                                        "example": 300
                                    },
                                    "amount": {
                                        "description": "Value in kobo (minor units)",
                                        "type": "integer",
                                        "example": 30000
                                    },
                                    "service_type": {
                                        "type": "string",
                                        "example": "airtime",
                                        "enum": [
                                            "airtime",
                                            "data",
                                            "electricity",
                                            "cable_tv"
                                        ]
                                    },
                                    "idempotency_key": {
                                        "description": "Unique key so a retried request is not processed twice",
                                        "type": "string",
                                        "example": "a1b2c3"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Redemption created"
                    },
                    "422": {
                        "description": "Validation error or insufficient points"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
